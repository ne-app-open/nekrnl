{
  "compiler_path": "x86_64-w64-mingw32-g++",
  "compiler_std": "c++20",
  "headers_path": ["../libSystem", "../", "../basehost", "../../public/frameworks"],
  "sources_path": ["src/*.cpp", "src/*.S"],
  "output_name": "drvhost.exe",
  "compiler_flags": [
    "-ffreestanding",
    "-shared",
    "-fPIC",
    "-fno-rtti",
    "-fno-exceptions",
    "-Wl,--subsystem=17",
    "-L../libSystem",
    "-lSystem"
  ],
  "cpp_macros": [
      "kDrvLaunchHostVersion=0x0200",
      "kDrvLaunchHostVersionHighest=0x0200",
      "kDrvLaunchHostVersionLowest=0x0200"
  ],
  "description": "The Ne.app Base Driver Host to launch user drivers."
}
