{
  "compiler_path": "aarch64-w64-mingw32-g++",
  "compiler_std": "c++20",
  "headers_path": [
    "../",
    "../libSystem",
    "../minkernel",
    "./"
  ],
  "sources_path": [
    "src/*.cpp"
  ],
  "output_name": "hal.arm64.dll",
  "compiler_flags": [
    "-ffreestanding",
    "-shared",
    "-fPIC",
    "-fno-rtti",
    "-fno-exceptions",
    "-Wl,--subsystem=17"
  ],
  "cpp_macros": [
    "kHALVersion=0x0100",
    "kHALVersionHighest=0x0100",
    "kHALVersionLowest=0x0100",
    "__NE_ARM64__"
  ],
  "description": "The Ne.app NeKernel Hardware Abstraction Layer."
}