{
  "compiler_path": "mingw-woarm64-g++",
  "compiler_std": "c++20",
  "headers_path": [
    "../",
    "../../",
    "../../../minkernel",
    "../../../",
    "./"
  ],
  "sources_path": [
    "*.cpp",
    "*.S",
    "../../private/HEL/ARM64/*.cpp",
    "../../private/HEL/ARM64/*.S",
    "../../private/*.cpp"
  ],
  "output_name": "net.efi",
  "compiler_flags": [
    "-nostdlib",
    "-std=c++20",
    "-fno-rtti",
    "-fno-exceptions",
    "-Wl,--subsystem=17,--image-base,0x20000000,-e,BootNetModuleMain"
  ],
  "cpp_macros": [
    "__BOOTZ__",
    "__BOOTZ_STANDALONE__",
    "__NE_ARM64__",
    "__nekernel_max_cores=8 ",
    "kBootNetVersionHighest=0x0100",
    "kBootNetVersionLowest=0x0100",
    "kBootNetEFIVersion=0x0100"
  ]
}
